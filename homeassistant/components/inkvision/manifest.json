{
  "domain": "inkvision",
  "name": "inkVision",
  "categories": ["sensors.air_quality", "sensors.temperature_humidity"],
  "codeowners": ["@11ado33"],
  "config_flow": true,
  "connectivity": ["network"],
  "documentation": "https://www.home-assistant.io/integrations/inkvision",
  "integration_type": "device",
  "iot_class": "local_push",
  "loggers": ["pyinkvision"],
  "quality_scale": "bronze",
  "requirements": ["pyinkvision==0.1.0"],
  "zeroconf": [
    {
      "name": "atmos*",
      "type": "_http._tcp.local."
    },
    {
      "name": "homebrainz*",
      "type": "_http._tcp.local."
    }
  ]
}
