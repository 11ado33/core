{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "not_inkvision_device": "[%key:component::inkvision::config::error::not_inkvision_device%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "not_inkvision_device": "The device at this address is not an inkVision device."
    },
    "flow_title": "{name}",
    "step": {
      "discovery_confirm": {
        "description": "Do you want to set up {name}?"
      },
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]"
        },
        "data_description": {
          "host": "The hostname or IP address of the inkVision device."
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "breath_voc": {
        "name": "Breath VOC"
      },
      "co2_equivalent": {
        "name": "CO₂ equivalent"
      },
      "gas_resistance": {
        "name": "Gas resistance"
      },
      "indoor_air_quality": {
        "name": "Indoor air quality"
      }
    }
  },
  "exceptions": {
    "update_error": {
      "message": "An error occurred while communicating with the inkVision device: {error}"
    }
  }
}
